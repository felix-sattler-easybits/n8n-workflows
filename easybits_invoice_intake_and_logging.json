    {
      "parameters": {
        "jsCode": "const newItems = [];\nconst MIN_SIZE_BYTES = 10 * 1024; // 10 KB threshold\n\nfunction getBytes(size) {\n  if (size === undefined || size === null) return null;\n  if (typeof size === 'number') return size;\n\n  if (typeof size === 'string') {\n    const clean = size.trim().toLowerCase();\n    const match = clean.match(/^([\\d.]+)\\s*([a-z]*)$/);\n    if (!match) return parseFloat(clean) || null;\n\n    const val = parseFloat(match[1]);\n    const unit = match[2];\n\n    if (unit.startsWith('k')) return val * 1024;\n    if (unit.startsWith('m')) return val * 1024 * 1024;\n    if (unit.startsWith('g')) return val * 1024 * 1024 * 1024;\n    if (unit.startsWith('b') || unit === '') return val;\n    return val * 1024;\n  }\n  return null;\n}\n\nfor (const item of $input.all()) {\n  if (!item.binary || Object.keys(item.binary).length === 0) {\n    throw new Error(\"No binary attachments found on this item. Please verify that 'Download Attachments' is enabled on your trigger node and that the test email contains a file attachment.\");\n  }\n\n  const binaryKeys = Object.keys(item.binary);\n\n  for (const key of binaryKeys) {\n    const attachment = item.binary[key];\n    let bytes = getBytes(attachment.fileSize);\n\n    if (bytes === null && attachment.data) {\n      bytes = Math.round((attachment.data.length * 3) / 4);\n    }\n\n    if (bytes === null || bytes >= MIN_SIZE_BYTES) {\n      newItems.push({\n        json: { ...item.json },\n        binary: {\n          data: attachment\n        }\n      });\n    }\n  }\n}\n\nreturn newItems;"
      },
